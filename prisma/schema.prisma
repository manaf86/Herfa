// حِرفة — نموذج المرحلة الأولى (MVP):
//   - المستخدمون + الجلسات (auth)
//   - الخدمات (Gig) + الباقات (Package)
// TODO: نضيف Orders / Milestones / Escrow في المرحلة اللاحقة.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String     @id @default(uuid())
  email         String?    @unique
  phone         String?    @unique
  passwordHash  String?
  name          String
  avatarLetter  String     @default("أ")
  role          UserRole   @default(BUYER)
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  sessions      Session[]
  gigs          Gig[]
  buyerOrders   Order[]    @relation("buyer")
  sellerOrders  Order[]    @relation("seller")
  messages      Message[]
  ledgerEntries LedgerEntry[]
}

enum UserRole {
  BUYER
  SELLER
  BOTH
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique @default(uuid())
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
}

// ═══════════ الخدمات (Gig) ═══════════

model Gig {
  id           String       @id @default(uuid())
  slug         String       @unique
  sellerId     String
  seller       User         @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  title        String
  description  String
  categoryId   String
  tags         String[]
  status       GigStatus    @default(DRAFT)
  aiDisclosure AiDisclosure @default(HUMAN)
  packages     Package[]
  orders       Order[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([categoryId, status])
  @@index([sellerId])
}

model Package {
  id           String @id @default(uuid())
  gigId        String
  gig          Gig    @relation(fields: [gigId], references: [id], onDelete: Cascade)
  tier         Tier
  title        String
  description  String
  // القاعدة #4 من CLAUDE.md: لا Float للمال. نخزّن الهللات كـ Int.
  priceMinor   Int
  currency     String @default("SAR")
  deliveryDays Int
  revisions    Int
  features     String[]
  orders       Order[]

  @@unique([gigId, tier])
}

enum GigStatus {
  DRAFT
  PUBLISHED
  PAUSED
}

enum AiDisclosure {
  HUMAN
  AI_ASSISTED
  AI_GENERATED
}

enum Tier {
  BASIC
  STANDARD
  PREMIUM
}

// ═══════════ الطلبات (Order) ═══════════
// المرجع: docs/spec/01-order-lifecycle.md
// ملاحظة: DISPUTED غير مدرج في هذا الـ enum لأن غرفة النزاع بشرية
// في MVP (تُدار بالبريد) — نُضيفه لاحقاً عند بناء غرفة النزاع.
//
// كذلك: PENDING_PAYMENT معرَّف كحالة بداية رسمية،
// لكننا نتخطّاه في الإنشاء الآن (نبدأ من AWAITING_REQUIREMENTS)
// لأن مزوّد الدفع لم يُربَط بعد. القاعدة #9 من CLAUDE.md.

model Order {
  id             String      @id @default(uuid())
  reference      String      @unique
  gigId          String
  gig            Gig         @relation(fields: [gigId], references: [id])
  packageId      String
  package        Package     @relation(fields: [packageId], references: [id])
  buyerId        String
  buyer          User        @relation("buyer", fields: [buyerId], references: [id])
  sellerId       String
  seller         User        @relation("seller", fields: [sellerId], references: [id])

  status         OrderStatus @default(PENDING_PAYMENT)

  // ملاحظة: amountMinor نسخة وقت الطلب — لا يتغيّر إن غيّر البائع السعر لاحقاً.
  amountMinor    Int
  currency       String      @default("SAR")

  requirements   String?
  timerStartedAt DateTime?
  dueAt          DateTime?
  deliveredAt    DateTime?
  acceptedAt     DateTime?

  events         OrderEvent[]
  messages       Message[]
  payment        Payment?
  ledgerEntries  LedgerEntry[]

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([buyerId, status])
  @@index([sellerId, status])
}

// append-only — لا UPDATE ولا DELETE على هذا الجدول في الكود.
// المصدر الوحيد للحقيقة عن ماذا حدث ومتى.
model OrderEvent {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String
  actorId   String?
  payload   Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

model Message {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

enum OrderStatus {
  PENDING_PAYMENT
  AWAITING_REQUIREMENTS
  IN_PROGRESS
  DELIVERED
  REVISION_REQUESTED
  ACCEPTED
  COMPLETED
  CANCELLED
}

// ═══════════ الدفتر المالي (Ledger) ═══════════
// المرجع: CLAUDE.md §القاعدة 4:
//   "كل حركة مالية: معاملة ذرية + مفتاح تفرّد (Idempotency Key) +
//    سجل في `ledger` غير قابل للتعديل (append-only)."
//
// append-only بالتصميم:
//   - لا @updatedAt (لا تحديث بعد الإنشاء).
//   - أي تصحيح يُكتَب صفاً جديداً معاكساً (compensating entry).
//   - Chargeback مثالاً: لا نُحدّث الصف الأصلي — نضيف CHARGEBACK جديداً
//     ثم SELLER_PROTECTION من صندوق الحماية (§القاعدة 14).

model LedgerEntry {
  id             String      @id @default(uuid())
  orderId        String?
  order          Order?      @relation(fields: [orderId], references: [id])
  userId         String
  user           User        @relation(fields: [userId], references: [id])
  type           LedgerType
  state          FundState
  amountMinor    Int
  currency       String      @default("SAR")
  // Idempotency: مانع الازدواج عند إعادة إرسال webhook أو استدعاء API.
  idempotencyKey String      @unique
  providerRef    String?
  note           String?
  createdAt      DateTime    @default(now())

  @@index([userId, state])
  @@index([orderId])
}

enum LedgerType {
  ESCROW_HOLD           // حجز في الخزنة عند دفع المشتري
  ESCROW_RELEASE        // إفراج للبائع عند الاعتماد
  COMMISSION            // عمولة المنصة
  BUYER_FEE             // رسوم مشترٍ (إن وُجدت)
  TIP                   // إكرامية اختيارية للبائع
  PAYOUT                // سحب البائع لحساب بنكي
  REFUND                // استرداد كامل/جزئي للمشتري
  CHARGEBACK            // اعتراض بطاقي من بنك المشتري
  SELLER_PROTECTION     // تعويض البائع من صندوق الحماية (§القاعدة 14)
}

enum FundState {
  IN_ESCROW             // محجوز في الخزنة
  PENDING_CLEARANCE     // بعد ACCEPTED — 5 أيام قبل السحب (§القاعدة 12)
  AVAILABLE             // متاح للسحب
  WITHDRAWN             // سُحب إلى البنك
  REVERSED              // عُكس (chargeback / refund)
}

// ═══════════ الدفع — استدعاء مزوّد مرخّص فقط ═══════════
// CLAUDE.md §القاعدة 9: "لا تكتب كود دفع أو ضمان. المنصة تستدعي مزوّداً مرخّصاً فقط."
// نحفظ هنا فقط: طلب الدفع، معرّفه لدى المزوّد، وحالة الرد.
// المنطق المالي (تشفير البطاقة، PSD2، 3DS) في مزوّد الدفع لا عندنا.

model Payment {
  id                 String        @id @default(uuid())
  orderId            String        @unique
  order              Order         @relation(fields: [orderId], references: [id])
  provider           String        @default("moyasar")
  providerPaymentId  String?       @unique
  status             PaymentStatus @default(INITIATED)
  amountMinor        Int
  currency           String        @default("SAR")
  idempotencyKey     String        @unique
  metadata           Json          @default("{}")
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

enum PaymentStatus {
  INITIATED
  PAID
  FAILED
  REFUNDED
}
