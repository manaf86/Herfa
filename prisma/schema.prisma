// حِرفة — نموذج المرحلة الأولى (MVP):
//   - المستخدمون + الجلسات (auth)
//   - الخدمات (Gig) + الباقات (Package)
// TODO: نضيف Orders / Milestones / Escrow في المرحلة اللاحقة.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String     @id @default(uuid())
  email         String?    @unique
  phone         String?    @unique
  passwordHash  String?
  name          String
  avatarLetter  String     @default("أ")
  role          UserRole   @default(BUYER)
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  sessions      Session[]
  gigs          Gig[]
  buyerOrders   Order[]    @relation("buyer")
  sellerOrders  Order[]    @relation("seller")
  messages      Message[]
}

enum UserRole {
  BUYER
  SELLER
  BOTH
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique @default(uuid())
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
}

// ═══════════ الخدمات (Gig) ═══════════

model Gig {
  id           String       @id @default(uuid())
  slug         String       @unique
  sellerId     String
  seller       User         @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  title        String
  description  String
  categoryId   String
  tags         String[]
  status       GigStatus    @default(DRAFT)
  aiDisclosure AiDisclosure @default(HUMAN)
  packages     Package[]
  orders       Order[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([categoryId, status])
  @@index([sellerId])
}

model Package {
  id           String @id @default(uuid())
  gigId        String
  gig          Gig    @relation(fields: [gigId], references: [id], onDelete: Cascade)
  tier         Tier
  title        String
  description  String
  // القاعدة #4 من CLAUDE.md: لا Float للمال. نخزّن الهللات كـ Int.
  priceMinor   Int
  currency     String @default("SAR")
  deliveryDays Int
  revisions    Int
  features     String[]
  orders       Order[]

  @@unique([gigId, tier])
}

enum GigStatus {
  DRAFT
  PUBLISHED
  PAUSED
}

enum AiDisclosure {
  HUMAN
  AI_ASSISTED
  AI_GENERATED
}

enum Tier {
  BASIC
  STANDARD
  PREMIUM
}

// ═══════════ الطلبات (Order) ═══════════
// المرجع: docs/spec/01-order-lifecycle.md
// ملاحظة: DISPUTED غير مدرج في هذا الـ enum لأن غرفة النزاع بشرية
// في MVP (تُدار بالبريد) — نُضيفه لاحقاً عند بناء غرفة النزاع.
//
// كذلك: PENDING_PAYMENT معرَّف كحالة بداية رسمية،
// لكننا نتخطّاه في الإنشاء الآن (نبدأ من AWAITING_REQUIREMENTS)
// لأن مزوّد الدفع لم يُربَط بعد. القاعدة #9 من CLAUDE.md.

model Order {
  id             String      @id @default(uuid())
  reference      String      @unique
  gigId          String
  gig            Gig         @relation(fields: [gigId], references: [id])
  packageId      String
  package        Package     @relation(fields: [packageId], references: [id])
  buyerId        String
  buyer          User        @relation("buyer", fields: [buyerId], references: [id])
  sellerId       String
  seller         User        @relation("seller", fields: [sellerId], references: [id])

  status         OrderStatus @default(PENDING_PAYMENT)

  // ملاحظة: amountMinor نسخة وقت الطلب — لا يتغيّر إن غيّر البائع السعر لاحقاً.
  amountMinor    Int
  currency       String      @default("SAR")

  requirements   String?
  timerStartedAt DateTime?
  dueAt          DateTime?
  deliveredAt    DateTime?
  acceptedAt     DateTime?

  events         OrderEvent[]
  messages       Message[]

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([buyerId, status])
  @@index([sellerId, status])
}

// append-only — لا UPDATE ولا DELETE على هذا الجدول في الكود.
// المصدر الوحيد للحقيقة عن ماذا حدث ومتى.
model OrderEvent {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String
  actorId   String?
  payload   Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

model Message {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

enum OrderStatus {
  PENDING_PAYMENT
  AWAITING_REQUIREMENTS
  IN_PROGRESS
  DELIVERED
  REVISION_REQUESTED
  ACCEPTED
  COMPLETED
  CANCELLED
}
